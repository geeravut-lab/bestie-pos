# ───────────────────────────────────────────────────────────────────────────
# Bestie POS — environment variables. Copy to `.env.local` (git-ignored).
# Full explanation: docs/ENVIRONMENT.md
# ───────────────────────────────────────────────────────────────────────────

# ── PUBLIC (shipped to the browser; VITE_ prefix) ──────────────────────────
# Supabase project URL (public, safe to commit).
VITE_SUPABASE_URL=https://pqomylchauwecpgqxoad.supabase.co
# Supabase *anon* key (Dashboard → Project Settings → API). Public by design;
# data is protected by Row Level Security, not by hiding this key.
VITE_SUPABASE_ANON_KEY=

# Public origin of the deployed platform (used for auth redirects / callbacks).
VITE_SITE_URL=https://bestie-pos.vercel.app

# Aivora (LINE) SSO — public values. The slug is what the Aivora hub registered for this app.
# Leave VITE_AIVORA_APP_SLUG empty to hide the "Sign in with LINE" button.
VITE_AIVORA_HUB_URL=https://aivora-lc.netlify.app
VITE_AIVORA_APP_SLUG=

# ── SERVER ONLY (Vercel Functions in apps/*/api, `functions/`) ─────────────
# NEVER prefix these with VITE_ / NEXT_PUBLIC_ / PUBLIC_. Set them in the
# Vercel dashboard (Project → Settings → Environment Variables), not in git.
SUPABASE_URL=https://pqomylchauwecpgqxoad.supabase.co
# service_role bypasses RLS completely. Server functions only.
SUPABASE_SERVICE_ROLE_KEY=

# Aivora SSO server side (same slug as above, plus the hub's exchange endpoint).
AIVORA_APP_SLUG=
# Either AIVORA_HUB_URL (hub base, the exchange path is derived) or an explicit AIVORA_HUB_EXCHANGE_URL.
AIVORA_HUB_URL=https://aivora-lc.netlify.app
AIVORA_HUB_EXCHANGE_URL=
# Host used for synthetic addresses of SSO users (aivora+<id>@host).
SITE_HOST=bestie-pos.vercel.app

# AI assistant providers (server only). Leave empty to keep a provider switched off; the admin screen only shows
# whether a key exists, never its value. Base URLs are locked in code (never configurable).
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=          # GOOGLE_AI_API_KEY is accepted as an alias

# LINE Official Account (Messaging API) — server only. Leave empty to hide "Connect LINE".
# Webhook URL to register in the LINE Developers console: https://bestie-pos.vercel.app/api/line/webhook
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# The OA's basic ID, e.g. @123abcde (used for the add-friend and "send code" links).
LINE_BASIC_ID=
# Random string used as the HMAC key for link codes (generate: openssl rand -hex 32). Not the channel secret.
LINE_CODE_SECRET=
