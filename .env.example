# ───────────────────────────────────────────────────────────────────────────
# Bestie POS — environment variables. Copy to `.env.local` (git-ignored).
# Full explanation: docs/ENVIRONMENT.md
# ───────────────────────────────────────────────────────────────────────────

# ── PUBLIC (shipped to the browser; VITE_ prefix) ──────────────────────────
# Supabase project URL (public, safe to commit).
VITE_SUPABASE_URL=https://pqomylchauwecpgqxoad.supabase.co
# Supabase *anon* key (Dashboard → Project Settings → API). Public by design;
# data is protected by Row Level Security, not by hiding this key.
VITE_SUPABASE_ANON_KEY=

# Public origin of the deployed platform (used for auth redirects / callbacks).
VITE_SITE_URL=https://bestie-pos.vercel.app

# ── SERVER ONLY (Vercel Functions in apps/*/api, `functions/`) ─────────────
# NEVER prefix these with VITE_ / NEXT_PUBLIC_ / PUBLIC_. Set them in the
# Vercel dashboard (Project → Settings → Environment Variables), not in git.
SUPABASE_URL=https://pqomylchauwecpgqxoad.supabase.co
# service_role bypasses RLS completely. Server functions only.
SUPABASE_SERVICE_ROLE_KEY=
